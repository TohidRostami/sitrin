# این فایل نمونه‌ست — کپی‌اش کن به «.env» (بدون .example) کنار همین فایل، و
# مقادیر واقعی رو جایگزین کن. فایل «.env» هیچ‌وقت نباید commit بشه.
#
#   cp .env.production.example .env

# ─── دیتابیس (کاملاً محلی روی همین سرور) ─────────────────────────
# مسیر داخل کانتینره، نه روی هاست — چون به /app/data که در docker-compose.yml
# روی یک Docker volume (نه فایل‌سیستم موقت کانتینر) mount شده اشاره می‌کنه.
DATABASE_URL="file:/app/data/production.db"

# این دو رو عمداً خالی/حذف نگه دار — همین که TURSO_DATABASE_URL خالی باشه،
# lib/db.ts خودش می‌فهمه باید سراغ SQLite محلی بره، نه Turso.
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=

# ─── دامنه‌ی واقعی ─────────────────────────────────────────────────
# هر دو باید دقیقاً همون دامنه‌ای باشن که در Caddyfile گذاشتی — وگرنه
# لاگین/سشن (کوکی‌ها) و لینک‌های داخل ایمیل/پیامک خراب می‌شن.
BETTER_AUTH_URL="https://siitrin.com"
NEXT_PUBLIC_SITE_URL="https://siitrin.com"

# با: openssl rand -base64 32
# ⚠️ حتماً یک مقدار تازه بساز — همونی که موقع تست لوکال استفاده کردی رو
# اینجا کپی نکن.
BETTER_AUTH_SECRET=""

# ─── پیامک (OTP) ──────────────────────────────────────────────────
# تا وقتی خالی باشه، کد OTP فقط در لاگ کانتینر چاپ می‌شه (docker compose logs app)
SMS_PROVIDER_API_KEY=""

# ─── درگاه پرداخت ─────────────────────────────────────────────────
# تا وقتی خالی باشه، مسیر خرید از درگاه شبیه‌سازی‌شده عبور می‌کنه.
PAYMENT_GATEWAY_MERCHANT_ID=""

# ─── Object Storage آروان‌کلاد (عکس محصولات، پنل ادمین) ──────────
ARVAN_ENDPOINT="https://s3.ir-thr-at1.arvanstorage.ir"
ARVAN_BUCKET=""
ARVAN_ACCESS_KEY=""
ARVAN_SECRET_KEY=""
ARVAN_PUBLIC_URL_BASE=""
